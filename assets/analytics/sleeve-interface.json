  "book_accounting_source": {
    "source_id": "netnet-book-accounting-bytecode-20260925",
    "url": "https://robinhoodchain.blockscout.com/api/v2/smart-contracts/0x3174dE69a84c53F82F6B6Dca5C64E705cFFe8Dd6",
